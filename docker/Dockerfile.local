# syntax=docker/dockerfile:1-labs
FROM nvidia/cuda:12.8.2-devel-ubuntu22.04

ARG PYTHON_VERSION=3.12
ARG MAX_JOBS=8

ENV DEBIAN_FRONTEND=noninteractive \
    CUDA_HOME=/usr/local/cuda \
    CUDA_PATH=/usr/local/cuda \
    CUDACXX=/usr/local/cuda/bin/nvcc \
    TORCH_CUDA_ARCH_LIST=7.5 \
    VLLM_TARGET_DEVICE=cuda \
    CMAKE_BUILD_TYPE=Release \
    FLASHINFER_ENABLE_AOT=1 \
    PYTHONUNBUFFERED=1 \
    VLLM_VERSION_OVERRIDE=0.1.5 \
    UV_PYTHON_DOWNLOADS=automatic \
    PIP_BREAK_SYSTEM_PACKAGES=1

ENV PATH=/usr/local/cuda/bin:${PATH}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl wget ca-certificates \
    python3 python3-dev python3-venv python3-pip \
    build-essential cmake ninja-build pkg-config \
    libnuma-dev ccache xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir -U pip setuptools wheel uv

WORKDIR /opt/vllm-2080ti
COPY . /opt/vllm-2080ti
ENV PATH=/opt/vllm-2080ti/.venv/bin:/usr/local/cuda/bin:${PATH}

RUN uv python install "${PYTHON_VERSION}" && uv python list | sed -n '1,20p'

RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv --python "${PYTHON_VERSION}" .venv \
    && uv pip install --python .venv/bin/python -U \
        pip \
        "setuptools>=77.0.3,<81.0.0" \
        wheel \
        "setuptools-scm>=8.0" \
        "packaging>=24.2" \
        "cmake>=3.26.1" \
        ninja \
        jinja2

RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/root/.cache/ccache \
    --device=nvidia.com/gpu=all \
    ASSUME_YES=1 PYTHON_VERSION="${PYTHON_VERSION}" MAX_JOBS="${MAX_JOBS}" ./build.sh

# Create the entrypoint inline so this Dockerfile can be copied directly into your patched repo root.
RUN cat > /usr/local/bin/vllm-2080ti-entrypoint <<'BASH' && chmod +x /usr/local/bin/vllm-2080ti-entrypoint
#!/usr/bin/env bash
set -euo pipefail
APP=${APP:-/opt/vllm-2080ti}
cd "$APP"
export PATH="$APP/.venv/bin:/usr/local/cuda/bin:$PATH"
export CUDA_HOME="${CUDA_HOME:-/usr/local/cuda}"
export CUDA_PATH="${CUDA_PATH:-$CUDA_HOME}"
export CUDACXX="${CUDACXX:-$CUDA_HOME/bin/nvcc}"
export RUNTIME_ROOT="${RUNTIME_ROOT:-$APP}"
export PROFILE_DIR="${PROFILE_DIR:-$APP/profiles}"
export LOG_DIR="${LOG_DIR:-$APP/run-logs}"
export MODEL_DIR="${MODEL_DIR:-/model}"
export PROFILE="${PROFILE:-qwen27b/safe/int4/fp16kv-256K-mtp3-text-only.env}"
export MODE="${MODE:-safe}"
export PORT="${PORT:-8000}"
export SERVICE_SCOPE="${SERVICE_SCOPE:-lan}"
export GPU_DEVICES="${GPU_DEVICES:-${CUDA_VISIBLE_DEVICES:-0,1}}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-$GPU_DEVICES}"
export PYTHONUNBUFFERED=1
mkdir -p "$LOG_DIR"
cmd="${1:-launcher}"; shift || true
case "$cmd" in
  launcher)
    args=("$@")
    [[ ${#args[@]} -gt 0 ]] || args=(--non-interactive)
    ./launcher.sh "${args[@]}"
    state="${STATE_FILE:-$LOG_DIR/start-manager.state}"
    for _ in $(seq 1 60); do
      if [[ -f "$state" ]]; then
        source "$state" || true
        [[ -n "${LAST_PID_FILE:-}" && -f "${LAST_PID_FILE:-}" ]] && break
      fi
      sleep 1
    done
    if [[ -z "${LAST_PID_FILE:-}" || ! -f "${LAST_PID_FILE:-}" ]]; then
      echo "launcher returned but no PID file was found" >&2
      exit 1
    fi
    server_pid="$(cat "$LAST_PID_FILE")"
    [[ -n "$server_pid" && -d "/proc/$server_pid" ]] || { echo "server process is not running" >&2; exit 1; }
    [[ -n "${LAST_LOG_FILE:-}" && -f "$LAST_LOG_FILE" ]] && tail -n "${TAIL_LINES:-80}" -F "$LAST_LOG_FILE" & tail_pid=$! || tail_pid=""
    trap 'kill -TERM "$server_pid" 2>/dev/null || true; [[ -n "${tail_pid:-}" ]] && kill "$tail_pid" 2>/dev/null || true' TERM INT
    while kill -0 "$server_pid" 2>/dev/null; do sleep 2; done
    ;;
  api)
    exec "$APP/.venv/bin/python" -m vllm.entrypoints.openai.api_server "$@"
    ;;
  check)
    exec bash -lc 'nvidia-smi && /opt/vllm-2080ti/.venv/bin/python - <<"PY"
import sys, torch, vllm
print("python", sys.version)
print("torch", torch.__version__)
print("cuda_available", torch.cuda.is_available())
print("cuda_device_count", torch.cuda.device_count())
print("vllm", getattr(vllm, "__version__", "unknown"))
PY'
    ;;
  rebuild)
    exec bash -lc 'ASSUME_YES=1 PYTHON_VERSION="${PYTHON_VERSION:-3.12}" MAX_JOBS="${MAX_JOBS:-8}" ./build.sh'
    ;;
  bash|sh|python|python3|nvidia-smi)
    exec "$cmd" "$@"
    ;;
  *)
    exec "$cmd" "$@"
    ;;
esac
BASH

RUN mkdir -p /model /data /opt/vllm-2080ti/run-logs \
    && rm -rf /tmp/* /root/.cache/pip

EXPOSE 8000
WORKDIR /opt/vllm-2080ti
ENTRYPOINT ["/usr/local/bin/vllm-2080ti-entrypoint"]
CMD ["launcher", "--non-interactive"]
